    {
      "section": "4.1",
      "section_title": "Android 内存模型全景",
      "priority": 85,
      "reason": "[Deep Tech Review] 4.1 Android 内存模型全景 存在技术审计问题，需回炉修正：Stack 物理占用、ZRAM physical used 口径仍未修正",
      "material_paths": [
        "intake/suggestions.md",
        "logs/deep-review/2026-04-29-05-deep-review.md"
      ],
      "review_issues": [
        {
          "level": "P1",
          "type": "原理断裂/数据口径",
          "location": "L259（Stack）",
          "detail": "正文把每线程约 1MB 默认栈直接乘以线程数，写成 50 个线程可能占 50MB。默认栈主要是虚拟地址空间保留，只有实际触碰的栈页才进入 RSS/PSS；线程数会增加 VSS、页表/guard page 和已用栈页开销，但不能把 1MB × 线程数当作稳定物理占用。",
          "suggestion": "拆成“虚拟栈保留”和“resident stack pages”；保留线程过多会增加内存压力的判断，不要把 50MB 写成默认 PSS/RSS 结论。",
          "evidence": [
            "Android pthread 默认栈约 1MB；Linux/Android 按页触碰后才占物理内存"
          ]
        },
        {
          "level": "P1",
          "type": "数据口径",
          "location": "L496（ZRAM dumpsys meminfo）",
          "detail": "正文写 physical used 接近 ZRAM 总大小表示压缩空间即将耗尽。dumpsys meminfo 中 physical used 是压缩后实际占用 RAM，in swap 是未压缩换出量，total swap 是 ZRAM 设备可容纳的未压缩 swap 容量。容量压力应看 in swap/SwapUsed 接近 total swap，不应把 physical used 与 total swap 对比。",
          "suggestion": "改为“123MB physical used 存 456MB uncompressed swap，压缩比约 3.7x；容量压力看 in swap/SwapUsed，RAM 开销看 physical used，压缩效率看两者比值”。",
          "evidence": [
            "Android dumpsys meminfo ZRAM 口径",
            "Linux zram mm_stat/orig_data_size 与 mem_used_total 语义"
          ]
        }
      ],
      "added_by": "task9-deep-tech-review",
      "added_at": "2026-04-26T01:28:54+08:00",
      "status": "completed",
      "last_reviewed_by": "task9-deep-tech-review",
      "last_reviewed_at": "2026-04-29T05:30:17+08:00",
      "completed_at": "2026-05-07T18:45:04+08:00",
      "completed_reason": "Stack物理占用已拆为虚拟栈保留+resident stack pages；ZRAM physical used口径已修正为三指标分读（physical used/in swap/total swap）"
    },
