      ],
      "review_issues": [
        {
          "type": "源码错误",
          "severity": "P1",
          "location": "L152-L158",
          "detail": "正文把 android.os.Trace.beginSection() 的 native 路径写成 libcutils/Trace.cpp。AOSP android-16.0.0_r1 中 JNI 入口在 frameworks/base/core/jni/android_os_Trace.cpp，libcutils 侧实现为 system/core/libcutils/trace-dev.cpp + trace-dev.inc，Trace.cpp 路径会让读者在现代分支找不到文件。",
          "suggestion": "改为 android_os_Trace.cpp → cutils/trace.h → system/core/libcutils/trace-dev.cpp/trace-dev.inc，并同步 last_verified_against。",
          "evidence": [
            "AOSP android-16.0.0_r1: frameworks/base/core/jni/android_os_Trace.cpp",
            "AOSP android-16.0.0_r1: system/core/libcutils/trace-dev.cpp / trace-dev.inc"
          ]
        },
        {
          "type": "源码准确性",
          "severity": "P1",
          "location": "L123",
          "detail": "“每一个 tracepoint 在 Perfetto SQL 中都有对应的表”表述过宽。sched 表是 Perfetto 对 sched_switch 等事件生成的调度切片视图，不等同于原始 ftrace event；部分事件只在 raw ftrace/generic event 或 counter 表中体现。",
          "suggestion": "拆成“原始 ftrace 事件”和“Perfetto 派生表/视图”两层说明，例子写成 sched_switch 参与生成 sched 表，cpu_frequency 可进入 cpu_frequency_counters。"
        },
        {
          "type": "源码准确性",
          "severity": "P1",
          "location": "L213-L214 / L219",
          "detail": "正文使用 ftrace_drain_period_ms、ftrace_buffer_size_kb 作为 TraceConfig 字段名。Perfetto FtraceConfig 的实际字段名是 drain_period_ms 与 buffer_size_kb；32KB 例子也容易被理解成默认值。Perfetto v43+ 建议多数配置不显式设置 buffer_size_kb，默认/下限通常远大于 32KB。",
          "suggestion": "把字段名改为 ftrace_config.drain_period_ms 和 ftrace_config.buffer_size_kb；说明 32KB 是反例，不是默认值，并补充 buffer_size_lower_bound 的版本口径。",
          "evidence": [
